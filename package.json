{
  "name": "aurorapad",
  "productName": "AuroraPad",
  "version": "1.0.0",
  "description": "AuroraPad — a modern Notepad++-style editor powered by Monaco",
  "main": "electron/main/index.js",
  "scripts": {
    "assets:generate-icons": "node scripts/generate-icons.js",
    "dev": "vite",
    "site:dev": "vite --open /website/",
    "build": "vite build",
    "preview": "vite preview",
    "site:preview": "vite preview --open /website/",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "npm run assets:generate-icons && vite build && electron-builder --win nsis portable --x64",
    "electron:build:linux": "npm run assets:generate-icons && vite build && electron-builder --linux AppImage tar.gz --x64",
    "electron:build:mac": "npm run assets:generate-icons && vite build && electron-builder --mac dmg zip",
    "start": "electron ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@mdi/font": "^7.4.47",
    "@vueuse/core": "^10.7.0",
    "chokidar": "^3.5.3",
    "electron-store": "^8.1.0",
    "file-type": "^19.0.0",
    "iconv-lite": "^0.6.3",
    "jschardet": "^3.1.4",
    "monaco-editor": "^0.47.0",
    "node-pty": "^1.1.0",
    "pinia": "^2.1.7",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.4.0",
    "vuetify": "^4.0.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.2",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.aurorapad.app",
    "productName": "AuroraPad",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "forceCodeSigning": false,
    "icon": "assets/aurorapad-app-icon",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/aurorapad-app-icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/aurorapad-app-icon.ico",
      "signAndEditExecutable": false
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/aurorapad-app-icon.png"
    }
  }
}
